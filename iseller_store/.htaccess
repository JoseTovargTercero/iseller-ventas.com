RewriteEngine On
RewriteBase /iseller_store/

# Si es un archivo o directorio real, servirlo directamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Las tiendas ahora se sirven desde la raíz: /iseller_store/<slug> -> /<slug>
RewriteCond %{REQUEST_URI} ^(.*)/iseller_store/([^/]+)/?$ [NC]
RewriteRule ^ %1/%2 [R=301,L,QSA]
