RewriteEngine On
# RewriteBase /

# Sin redirección automática de /login a /login/ (hay un directorio real con ese nombre)
DirectorySlash Off

# Redirigir /inventario a landing.php
RewriteRule ^inven?tario/?$ landing.php [L]

# La app POS se sirve bajo /inventario/ (mismas rutas que la raíz del proyecto)
# Se acepta también la variante con typo /invetario/ que ya usa la portada.
RewriteRule ^inven?tario/(.+)$ $1 [L,QSA]

# Rutas de autenticación (antes del router de slugs de tiendas)
RewriteRule ^login/?$ login.php [L,QSA]
RewriteRule ^registro/?$ registro.php [L,QSA]

# Conservar la barra final del resto de directorios reales (mod_dir está desactivado)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/login/?$
RewriteCond %{REQUEST_URI} !/registro/?$
RewriteRule ^(.*[^/])$ %{REQUEST_URI}/ [R=301,L]

# Si es un archivo o directorio real, servirlo directamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Si no, enviarlo a index.php para que maneje el slug
RewriteRule ^([^/]+)/?$ index.php?tienda_slug=$1 [L,QSA]
